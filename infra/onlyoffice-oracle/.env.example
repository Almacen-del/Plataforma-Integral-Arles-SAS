# Sustituir por un nombre DNS real que apunte al servidor de Oracle.
ONLYOFFICE_DOMAIN=editor.example.com
# Correo del responsable de renovar el certificado HTTPS.
ONLYOFFICE_CERT_EMAIL=responsable@example.com
# Generar en el servidor con: openssl rand -hex 32
# Mantener el mismo secreto en el servidor de la integracion; nunca en el navegador.
ONLYOFFICE_JWT_SECRET=
